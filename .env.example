# Base directory where your raw images or project datasets reside
BASE_DIR=./datasets

# Directory specifically containing model files (.pt, .onnx, etc)
MODELS_DIR=./models

# Optional custom output directory for the active dataset (defaults to BASE_DIR/dataset_<name>)
# OUTPUT_DIR=./datasets/dataset_default

# Inference confidence threshold (0.0 to 1.0)
CONF_THRESH=0.25
